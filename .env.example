# ATHENTIV FocusDock — environment template
# Copy to .env.local and adjust. Never commit real secrets (.env.local is git-ignored).

# --- Database -----------------------------------------------------------------
# Production (Vercel): a Turso database. Set BOTH values here AND in Vercel → Settings →
# Environment Variables. When set in .env.local, `pnpm dev` and the CLI scripts
# (db:migrate, stand:create, …) also use the live database.
# TURSO_DATABASE_URL=libsql://focusdock-yourname.turso.io
# TURSO_AUTH_TOKEN=eyJhbGciOi...

# Local development without Turso: a SQLite file (default ./data/focusdock.db).
DATABASE_PATH=./data/focusdock.db

# --- App ----------------------------------------------------------------------
# Public address of the app. Used to build the NFC tag URLs printed by `pnpm stand:create`.
# Set it to your live URL (e.g. https://athentiv.vercel.app) before creating stands.
APP_URL=http://localhost:3000

# Smartphone-only gate. Keep "on" (default). "off" disables it — for local debugging only.
DEVICE_GATE=on

# Payments: only the clearly labelled sandbox provider exists. "off" disables simulated purchases.
PAYMENTS_SANDBOX=on

# Session cookies are marked Secure automatically on HTTPS. Force with "true"/"false" if needed.
# COOKIE_SECURE=true

# Test-only: disables the in-memory IP rate limiter in development so `pnpm test:api` can be re-run.
# Ignored when NODE_ENV=production.
# RATE_LIMITS=off
