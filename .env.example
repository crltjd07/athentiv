# ATHENTIV FocusDock — environment template
# Copy to .env.local and adjust. Never commit real secrets.

# Public URL of the app. Used to build the NFC tag URLs printed by `pnpm db:seed` / `pnpm stand:create`.
# Must be reachable from the phone (e.g. https://focusdock.example.com or http://192.168.1.20:3000 on a LAN).
APP_URL=http://localhost:3000

# SQLite database file. Defaults to ./data/focusdock.db. Use a persistent disk in production.
DATABASE_PATH=./data/focusdock.db

# Smartphone-only gate. Keep "on" (default). "off" disables it — for local debugging only.
DEVICE_GATE=on

# Session cookies are marked Secure automatically when the request is HTTPS.
# Force with "true"/"false" if a reverse proxy hides the scheme.
# COOKIE_SECURE=true

# Payments: only the clearly labelled sandbox provider exists. Set to "off" to disable it entirely
# (e.g. on a public demo where you don't want simulated purchases).
PAYMENTS_SANDBOX=on

# Test-only: disables the in-memory IP rate limiter in development so `pnpm test:api` can be re-run.
# Ignored when NODE_ENV=production.
# RATE_LIMITS=off
